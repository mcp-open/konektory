FROM python:3.13.15-alpine3.23@sha256:7ea3f82de8ea6d4fb7e5d2bbe3fe3c9d931700b7a529f1fe5769e42abe514ca1
COPY sdk /deps/sdk
RUN apk upgrade --no-cache \
    && apk add --no-cache 'libuuid>=2.41.6-r1' \
    && pip install --no-cache-dir '/deps/sdk[test]' PyYAML==6.0.2 \
    && addgroup -S -g 10001 tester \
    && adduser -S -D -H -u 10001 -G tester tester
USER 10001:10001
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/workspace:/workspace/sdk/src
WORKDIR /workspace
